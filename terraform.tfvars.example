proxmox_endpoint = "https://pmx-4.purosurccd.com/api2/json"
proxmox_insecure = false
node_name        = "pmx-4"
ssh_public_key   = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHLniY7YxGRJpdvquofKsutVBW2+gWuILoARKGc95TsH pscadmin@purosurccd.com"

# template_vm_id must refer to an existing LXC container template.
# Optionally set template_node_name if the template lives on another node.
lxc_containers = {
  dns = {
    vm_id          = 201
    template_vm_id = 9001
    hostname       = "dns"
    datastore_id   = "local-lvm"
    disk_size_gb   = 8
    cores          = 1
    memory_mb      = 512
    bridge         = "vmbr0"
    ip_address     = "10.10.10.21/24"
    gateway        = "10.10.10.1"
    tags           = ["terraform", "lxc"]
  }
}

# template_vm_id must refer to an existing VM template with cloud-init enabled.
virtual_machines = {
  app = {
    vm_id          = 301
    template_vm_id = 9000
    name           = "app-01"
    datastore_id   = "local-lvm"
    disk_size_gb   = 32
    cores          = 2
    memory_mb      = 2048
    bridge         = "vmbr0"
    ip_address     = "10.10.10.31/24"
    gateway        = "10.10.10.1"
    tags           = ["terraform", "vm"]
  }
}
