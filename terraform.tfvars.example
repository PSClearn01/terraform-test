proxmox_endpoint = "https://pve.example.internal:8006/api2/json"
proxmox_insecure = false
node_name        = "pve"
ssh_public_key   = "ssh-ed25519 AAAA... admin@example"

# Download this template to the node first, for example:
# pveam download local debian-12-standard_12.7-1_amd64.tar.zst
lxc_containers = {
  dns = {
    vm_id        = 201
    hostname     = "dns"
    template     = "local:vztmpl/debian-12-standard_12.7-1_amd64.tar.zst"
    datastore_id = "local-lvm"
    disk_size_gb = 8
    cores        = 1
    memory_mb    = 512
    bridge       = "vmbr0"
    ip_address   = "10.10.10.21/24"
    gateway      = "10.10.10.1"
    tags         = ["terraform", "lxc"]
  }
}

# template_vm_id must refer to an existing VM template with cloud-init enabled.
virtual_machines = {
  app = {
    vm_id          = 301
    template_vm_id = 9000
    name           = "app-01"
    datastore_id   = "local-lvm"
    disk_size_gb   = 32
    cores          = 2
    memory_mb      = 2048
    bridge         = "vmbr0"
    ip_address     = "10.10.10.31/24"
    gateway        = "10.10.10.1"
    tags           = ["terraform", "vm"]
  }
}
